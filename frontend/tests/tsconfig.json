// Node runs these scripts as they are, so only the types are checked. Playwright comes from the prototype's install.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "playwright": ["../../prototype/node_modules/playwright/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "../scripts/locales.ts"]
}
